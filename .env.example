# ============================================================
# Tri-Agent Swarm Configuration
# Copy this file to .env and fill in your API keys
# ============================================================

# Google Gemini API Key
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# xAI Grok API Key  
# Get yours at: https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here

# Ollama Configuration (local models)
# Make sure Ollama is running: ollama serve
OLLAMA_HOST=http://localhost:11434

# Default model selections per agent
VISUAL_AGENT_BACKEND=gemini
VISUAL_AGENT_MODEL=gemini-2.5-flash
REASONING_AGENT_BACKEND=gemini
REASONING_AGENT_MODEL=gemini-2.5-flash
SYNTHESIS_AGENT_BACKEND=gemini
SYNTHESIS_AGENT_MODEL=gemini-2.5-flash

# Output directory
OUTPUT_DIR=./output
